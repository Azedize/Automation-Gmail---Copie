{
  "python-envs.defaultEnvManager": "ms-python.python:pyenv",
  "python.analysis.autoImportCompletions": true,

  "claudeCodeChat.permissions.yoloMode": false,
  "Codegeex.GenerationPreference": "automatic",
  "Codegeex.CommitMessage.LanguagePreference": "English",
  "Codegeex.CommitMessageStyle": "Auto",
  "Codegeex.SidebarUI.LanguagePreference": "English",

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },

  "black-formatter.args": ["--line-length", "100"],
  "black-formatter.importStrategy": "useBundled",

  "python.formatting.provider": "none"
}
